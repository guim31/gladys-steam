{
  "manifest_version": 1,
  "type": "device",
  "name": "Steam",
  "description": {
    "en": "Status of chosen Steam accounts: online, current game, playtime, parental control scenes.",
    "fr": "Statut de comptes Steam choisis : en ligne, jeu en cours, temps de jeu, scènes de contrôle parental.",
    "de": "Status ausgewählter Steam-Konten: online, aktuelles Spiel, Spielzeit, Jugendschutz-Szenen.",
    "es": "Estado de cuentas de Steam: en línea, juego actual, tiempo de juego, escenas de control parental."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-steam:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-steam/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Steam API key",
        "fr": "Votre clé d'API Steam",
        "de": "Dein Steam-API-Schlüssel",
        "es": "Su clave de API de Steam"
      },
      "description": {
        "en": "Get a free key on the Steam developer page (a Steam account with a purchase is needed). The current game is only visible on public profiles whose game details are public.",
        "fr": "Obtenez une clé gratuite sur la page développeur de Steam (il faut un compte Steam avec un achat). Le jeu en cours n'est visible que sur les profils publics dont les détails de jeu sont publics.",
        "de": "Hol dir einen kostenlosen Schlüssel auf der Steam-Entwicklerseite (ein Steam-Konto mit einem Kauf ist nötig). Das aktuelle Spiel ist nur bei öffentlichen Profilen mit öffentlichen Spieldetails sichtbar.",
        "es": "Obtenga una clave gratuita en la página de desarrolladores de Steam (se necesita una cuenta de Steam con una compra). El juego actual solo se ve en perfiles públicos con los detalles de juego públicos."
      },
      "links": [
        {
          "url": "https://steamcommunity.com/dev/apikey",
          "label": {
            "en": "Get a Steam API key",
            "fr": "Obtenir une clé d'API Steam",
            "de": "Steam-API-Schlüssel holen",
            "es": "Obtener una clave de API de Steam"
          }
        },
        {
          "url": "https://store.steampowered.com/account/",
          "label": {
            "en": "Your SteamID (account page)",
            "fr": "Votre SteamID (page du compte)",
            "de": "Deine SteamID (Kontoseite)",
            "es": "Su SteamID (página de la cuenta)"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "Steam API key",
        "fr": "Clé d'API Steam",
        "de": "Steam-API-Schlüssel",
        "es": "Clave de API de Steam"
      },
      "description": {
        "en": "32 characters, shown on steamcommunity.com/dev/apikey.",
        "fr": "32 caractères, affichée sur steamcommunity.com/dev/apikey.",
        "de": "32 Zeichen, angezeigt auf steamcommunity.com/dev/apikey.",
        "es": "32 caracteres, mostrada en steamcommunity.com/dev/apikey."
      },
      "required": true
    },
    {
      "key": "accounts",
      "type": "string",
      "label": {
        "en": "Accounts to follow",
        "fr": "Comptes à suivre",
        "de": "Zu verfolgende Konten",
        "es": "Cuentas a seguir"
      },
      "description": {
        "en": "Up to 20, separated by commas: SteamID64, profile URL or custom URL name.",
        "fr": "Jusqu'à 20, séparés par des virgules : SteamID64, URL de profil ou identifiant personnalisé.",
        "de": "Bis zu 20, durch Kommas getrennt: SteamID64, Profil-URL oder eigener URL-Name.",
        "es": "Hasta 20, separadas por comas: SteamID64, URL del perfil o nombre de URL personalizado."
      },
      "placeholder": {
        "en": "e.g. 76561198000000000, my_custom_name",
        "fr": "ex. 76561198000000000, my_custom_name",
        "de": "z. B. 76561198000000000, my_custom_name",
        "es": "p. ej. 76561198000000000, my_custom_name"
      },
      "required": true
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Steam is asked for the status of the accounts.",
        "fr": "Fréquence à laquelle Steam est interrogé sur le statut des comptes.",
        "de": "Wie oft Steam nach dem Status der Konten gefragt wird.",
        "es": "Con qué frecuencia se consulta a Steam el estado de las cuentas."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Also used for the texts sent to scenes (status, no game).",
        "fr": "Sert aussi aux textes envoyés aux scènes (statut, aucun jeu).",
        "de": "Gilt auch für die Texte an die Szenen (Status, kein Spiel).",
        "es": "También se usa para los textos enviados a las escenas (estado, ningún juego)."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_accounts",
      "label": {
        "en": "Check the accounts",
        "fr": "Vérifier les comptes",
        "de": "Konten prüfen",
        "es": "Comprobar las cuentas"
      },
      "description": {
        "en": "Resolves every account entered and tells whether its profile is public.",
        "fr": "Résout chaque compte saisi et indique si son profil est public.",
        "de": "Löst jedes eingegebene Konto auf und zeigt, ob sein Profil öffentlich ist.",
        "es": "Resuelve cada cuenta introducida e indica si su perfil es público."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "game_started",
      "label": {
        "en": "Starts playing",
        "fr": "Commence à jouer",
        "de": "Beginnt zu spielen",
        "es": "Empieza a jugar"
      },
      "description": {
        "en": "A followed account launches a game, or switches to another one.",
        "fr": "Un compte suivi lance un jeu, ou passe à un autre.",
        "de": "Ein verfolgtes Konto startet ein Spiel oder wechselt zu einem anderen.",
        "es": "Una cuenta seguida inicia un juego o cambia a otro."
      },
      "fields": [
        {
          "key": "account",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Steam account",
            "fr": "Compte Steam",
            "de": "Steam-Konto",
            "es": "Cuenta de Steam"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Game (exact name, optional)",
            "fr": "Jeu (nom exact, facultatif)",
            "de": "Spiel (genauer Name, optional)",
            "es": "Juego (nombre exacto, opcional)"
          },
          "placeholder": {
            "en": "e.g. Portal 2",
            "fr": "ex. Portal 2",
            "de": "z. B. Portal 2",
            "es": "p. ej. Portal 2"
          }
        }
      ],
      "variables": [
        {
          "key": "account_name",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Game",
            "fr": "Jeu",
            "de": "Spiel",
            "es": "Juego"
          }
        },
        {
          "key": "game_id",
          "type": "string",
          "label": {
            "en": "Steam app id",
            "fr": "Identifiant d'application Steam",
            "de": "Steam-App-ID",
            "es": "ID de aplicación de Steam"
          }
        }
      ]
    },
    {
      "key": "game_stopped",
      "label": {
        "en": "Stops playing",
        "fr": "Arrête de jouer",
        "de": "Hört auf zu spielen",
        "es": "Deja de jugar"
      },
      "description": {
        "en": "A followed account leaves a game (or switches to another one).",
        "fr": "Un compte suivi quitte un jeu (ou passe à un autre).",
        "de": "Ein verfolgtes Konto verlässt ein Spiel (oder wechselt zu einem anderen).",
        "es": "Una cuenta seguida sale de un juego (o cambia a otro)."
      },
      "fields": [
        {
          "key": "account",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Steam account",
            "fr": "Compte Steam",
            "de": "Steam-Konto",
            "es": "Cuenta de Steam"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Game (exact name, optional)",
            "fr": "Jeu (nom exact, facultatif)",
            "de": "Spiel (genauer Name, optional)",
            "es": "Juego (nombre exacto, opcional)"
          },
          "placeholder": {
            "en": "e.g. Portal 2",
            "fr": "ex. Portal 2",
            "de": "z. B. Portal 2",
            "es": "p. ej. Portal 2"
          }
        }
      ],
      "variables": [
        {
          "key": "account_name",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Game",
            "fr": "Jeu",
            "de": "Spiel",
            "es": "Juego"
          }
        },
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes played",
            "fr": "Minutes jouées",
            "de": "Gespielte Minuten",
            "es": "Minutos jugados"
          }
        }
      ]
    },
    {
      "key": "playing_for",
      "label": {
        "en": "Playing for more than…",
        "fr": "Joue depuis plus de…",
        "de": "Spielt seit mehr als…",
        "es": "Juega desde hace más de…"
      },
      "description": {
        "en": "The gaming session of an account reaches the chosen duration. Fires once per session; a break under 10 minutes does not end it.",
        "fr": "La session de jeu d'un compte atteint la durée choisie. Une seule fois par session ; une pause de moins de 10 minutes ne l'interrompt pas.",
        "de": "Die Spielsitzung eines Kontos erreicht die gewählte Dauer. Einmal pro Sitzung; eine Pause unter 10 Minuten beendet sie nicht.",
        "es": "La sesión de juego de una cuenta alcanza la duración elegida. Una vez por sesión; una pausa de menos de 10 minutos no la termina."
      },
      "fields": [
        {
          "key": "account",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Steam account",
            "fr": "Compte Steam",
            "de": "Steam-Konto",
            "es": "Cuenta de Steam"
          }
        },
        {
          "key": "minutes",
          "type": "select",
          "required": true,
          "label": {
            "en": "Duration",
            "fr": "Durée",
            "de": "Dauer",
            "es": "Duración"
          },
          "options": [
            {
              "value": "15",
              "label": {
                "en": "15 minutes",
                "fr": "15 minutes",
                "de": "15 Minuten",
                "es": "15 minutos"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minutes",
                "fr": "30 minutes",
                "de": "30 Minuten",
                "es": "30 minutos"
              }
            },
            {
              "value": "45",
              "label": {
                "en": "45 minutes",
                "fr": "45 minutes",
                "de": "45 Minuten",
                "es": "45 minutos"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "1 hour",
                "fr": "1 heure",
                "de": "1 Stunde",
                "es": "1 hora"
              }
            },
            {
              "value": "90",
              "label": {
                "en": "1.5 hours",
                "fr": "1,5 heures",
                "de": "1,5 Stunden",
                "es": "1,5 horas"
              }
            },
            {
              "value": "120",
              "label": {
                "en": "2 hours",
