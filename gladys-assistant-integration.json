              "label": {
                "en": "4 hours",
                "fr": "4 heures",
                "de": "4 Stunden",
                "es": "4 horas"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "account_name",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Game",
            "fr": "Jeu",
            "de": "Spiel",
            "es": "Juego"
          }
        },
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes reached",
            "fr": "Minutes atteintes",
            "de": "Erreichte Minuten",
            "es": "Minutos alcanzados"
          }
        }
      ]
    },
    {
      "key": "went_online",
      "label": {
        "en": "Comes online",
        "fr": "Se connecte",
        "de": "Geht online",
        "es": "Se conecta"
      },
      "description": {
        "en": "A followed account goes from offline to online, busy or away.",
        "fr": "Un compte suivi passe de hors ligne à en ligne, occupé ou absent.",
        "de": "Ein verfolgtes Konto wechselt von offline zu online, beschäftigt oder abwesend.",
        "es": "Una cuenta seguida pasa de desconectada a en línea, ocupada o ausente."
      },
      "fields": [
        {
          "key": "account",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Steam account",
            "fr": "Compte Steam",
            "de": "Steam-Konto",
            "es": "Cuenta de Steam"
          }
        }
      ],
      "variables": [
        {
          "key": "account_name",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status",
            "fr": "Statut",
            "de": "Status",
            "es": "Estado"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_account_status",
      "label": {
        "en": "Read a Steam account",
        "fr": "Lire un compte Steam",
        "de": "Steam-Konto lesen",
        "es": "Leer una cuenta de Steam"
      },
      "description": {
        "en": "Gives the status, the current game and the session length to the next steps of the scene.",
        "fr": "Donne le statut, le jeu en cours et la durée de session aux étapes suivantes de la scène.",
        "de": "Gibt Status, aktuelles Spiel und Sitzungsdauer an die nächsten Schritte der Szene weiter.",
        "es": "Pasa el estado, el juego actual y la duración de la sesión a los pasos siguientes de la escena."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "account",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Steam account",
            "fr": "Compte Steam",
            "de": "Steam-Konto",
            "es": "Cuenta de Steam"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "account_name",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status",
            "fr": "Statut",
            "de": "Status",
            "es": "Estado"
          }
        },
        {
          "key": "online",
          "type": "boolean",
          "label": {
            "en": "Online",
            "fr": "En ligne",
            "de": "Online",
            "es": "En línea"
          }
        },
        {
          "key": "in_game",
          "type": "boolean",
          "label": {
            "en": "In game",
            "fr": "En jeu",
            "de": "Im Spiel",
            "es": "Jugando"
          }
        },
        {
          "key": "game",
          "type": "string",
          "label": {
            "en": "Current game",
            "fr": "Jeu en cours",
            "de": "Aktuelles Spiel",
            "es": "Juego actual"
          }
        },
        {
          "key": "session_minutes",
          "type": "number",
          "label": {
            "en": "Session minutes",
            "fr": "Minutes de session",
            "de": "Sitzungsminuten",
            "es": "Minutos de sesión"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "accounts",
      "label": {
        "en": "Steam accounts",
        "fr": "Comptes Steam",
        "de": "Steam-Konten",
        "es": "Cuentas de Steam"
      },
      "description": {
        "en": "Who is online, who plays what and for how long.",
        "fr": "Qui est en ligne, qui joue à quoi et depuis combien de temps.",
        "de": "Wer online ist, wer was spielt und wie lange.",
        "es": "Quién está en línea, quién juega a qué y desde cuándo."
      },
      "icon": "play"
    }
  ]
}
